{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyche-institute/evidence-carrying-reassurance/spec/evidence-packet.schema.json",
  "title": "ecr-packet/0.2",
  "description": "A packet appraised by the reference verifier. Mandatory fields are those whose absence fails EvidenceOK (V03); optional fields are appraised by policy.",
  "type": "object",
  "required": ["profile", "case_id", "presented_at", "carrier_record", "evidence", "timestamp_token", "status_list", "co_approval"],
  "properties": {
    "profile": {"const": "ecr-packet/0.2"},
    "case_id": {"type": "string"},
    "presented_at": {"$ref": "#/$defs/time"},
    "carrier_record": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/carrierRecord"}]},
    "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/brokerEnvelope"}]},
    "timestamp_token": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/signed"}]},
    "status_list": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/signed"}]},
    "co_approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/signed"}]}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "required": ["alg", "canon", "key_id", "public_key", "value"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "canon": {"const": "RFC8785"},
        "key_id": {"$ref": "#/$defs/digest"},
        "public_key": {"type": "string"},
        "value": {"type": "string"}
      }
    },
    "signed": {
      "type": "object",
      "required": ["payload", "signature"],
      "properties": {"payload": {"type": "object"}, "signature": {"$ref": "#/$defs/signature"}}
    },
    "carrierRecord": {
      "type": "object",
      "required": ["carrier", "instance", "client", "service", "message_id", "request_id", "request_payload_sha256", "observed_at", "status", "source"],
      "properties": {
        "carrier": {"const": "x-road"},
        "instance": {"type": "string"},
        "client": {"type": "string"},
        "service": {"type": "string"},
        "message_id": {"type": "string"},
        "request_id": {"type": "string"},
        "request_hash": {"type": "string"},
        "request_payload_sha256": {"$ref": "#/$defs/digest"},
        "response_body_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "response_headers_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "http_status": {"type": "integer"},
        "observed_at": {"$ref": "#/$defs/time"},
        "status": {"enum": ["accepted", "rejected", "validation_unavailable", "timestamp_unavailable"]},
        "fault": {"type": ["string", "null"]},
        "message_log": {"type": ["object", "null"]},
        "source": {"type": "object", "required": ["artifact", "sha256", "basis"]}
      }
    },
    "receiptPayload": {
      "type": "object",
      "required": ["profile", "receipt_id", "issued_at", "subject", "issuer", "delegation", "carrier", "action", "runtime"],
      "properties": {
        "profile": {"const": "ecr-receipt/0.2"},
        "receipt_id": {"type": "string"},
        "issued_at": {"$ref": "#/$defs/time"},
        "subject": {"type": "object", "required": ["agent_id"], "properties": {"agent_id": {"type": "string"}, "runtime_instance": {"type": "string"}}},
        "issuer": {
          "type": "object",
          "required": ["id", "key_id"],
          "properties": {
            "id": {"type": "string"},
            "key_id": {"$ref": "#/$defs/digest"},
            "root": {"type": ["string", "null"]},
            "endorsements": {"type": "array", "items": {"$ref": "#/$defs/signed"}}
          }
        },
        "delegation": {
          "type": "object",
          "required": ["id", "grantor", "grantee", "scope", "valid_from", "valid_until", "status_source"],
          "properties": {
            "id": {"type": "string"}, "grantor": {"type": "string"}, "grantee": {"type": "string"},
            "scope": {"type": "array", "items": {"enum": ["read", "enrich", "mutate"]}},
            "valid_from": {"$ref": "#/$defs/time"}, "valid_until": {"$ref": "#/$defs/time"},
            "status_source": {"type": "string"}
          }
        },
        "carrier": {
          "type": "object",
          "required": ["carrier", "message_id", "request_id", "request_digest", "response_digest"],
          "properties": {
            "carrier": {"const": "x-road"}, "message_id": {"type": "string"}, "request_id": {"type": "string"},
            "request_digest": {"$ref": "#/$defs/digest"}, "response_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "action": {
          "type": "object",
          "required": ["class", "target", "tool"],
          "properties": {"class": {"enum": ["read", "enrich", "mutate"]}, "target": {"type": "string"}, "tool": {"type": "string"}, "summary": {"type": "string"}}
        },
        "runtime": {
          "type": "object",
          "required": ["model_version", "tool_profile_digest", "prompt_profile_digest"],
          "properties": {
            "model_version": {"type": "string"},
            "tool_profile_digest": {"$ref": "#/$defs/digest"},
            "prompt_profile_digest": {"$ref": "#/$defs/digest"},
            "verifier_profile": {"type": "string"}
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["payload", "signature"],
      "properties": {"payload": {"$ref": "#/$defs/receiptPayload"}, "signature": {"$ref": "#/$defs/signature"}},
      "not": {"required": ["attached_receipt"]}
    },
    "brokerEnvelope": {
      "type": "object",
      "required": ["payload", "signature", "attached_receipt"],
      "properties": {
        "payload": {
          "type": "object",
          "required": ["profile", "broker", "mapping_id", "mapping", "normalized", "attached_receipt_digest"],
          "properties": {
            "profile": {"const": "ecr-broker-envelope/0.2"},
            "broker": {"type": "string"},
            "mapping_id": {"type": "string"},
            "mapping": {"type": "array", "items": {"type": "object", "required": ["issuer", "root", "alias"]}},
            "normalized": {"type": "object", "required": ["issuer_alias", "root", "carrier_message_id", "request_digest", "response_digest"]},
            "attached_receipt_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "signature": {"$ref": "#/$defs/signature"},
        "attached_receipt": {"$ref": "#/$defs/receipt"}
      }
    }
  }
}
